# Framework-local state (gate_runner --log-dir default; project-local when
# framework is installed in a user's project tree).
.pi/
agent-workflow-logs/
# Re-include the project's own profile so contributors can commit changes
# without `-f`. Framework reads this on session_start; ignoring it would
# force every profile edit onto a stash-then-push dance.
!.pi/rolecast.yaml
# Re-include rolecast.yaml fixtures used by Node + Python integration tests.
# The tests/fixtures tree is the only place project-shaped .pi/ dirs belong
# in version control.
!tests/fixtures/sample-rust/.pi/
!tests/fixtures/sample-rust-v3/.pi/

# Build artifacts and dependencies (TS extension).
dist/
node_modules/
*.tsbuildinfo

# Python build / test artefacts (excluded from git tracking;
# package.json's `files[]` re-negates the `scripts/` ones for the npm tarball).
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# OS / editor.
.DS_Store
*.swp